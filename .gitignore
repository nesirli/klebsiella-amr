# Generated data and reference databases
data/
reference/

# Keep results/ unignored so final model files / reports can be pushed from a VPS

# Conda / Python
*.pyc
__pycache__/
*.egg-info/
.ipynb_checkpoints/

# Run logs
*.log

# OS
.DS_Store
results/multiqc/multiqc_report_data/

# Local build state: records the MAX_SAMPLES the split was last built with
results/metadata/.max-samples

# Streamlit password (never commit)
.streamlit/secrets.toml

# DNABERT-2 fine-tuned weights: 447 MB each, past GitHub's 100 MB limit.
# The tuning JSONs and metrics are kept; rerun `make dnabert` to rebuild these.
results/models/dnabert/*_model.pt

# Intermediate matrices: regenerated by the pipeline, deleted by `make report`.
# What the app serves is committed under app/artifacts/ instead.
results/features/
results/sequences/
